# Campanario — configuracao local. Copie para .env e nunca publique o .env.
CAMPANARIO_MODEL_NAME=qwen3.5:9b
CAMPANARIO_MODEL_THINK=false
# 8192 pode ajudar em prompts longos, mas exige mais VRAM; escolha conforme o modelo/hardware.
CAMPANARIO_MODEL_CONTEXT_WINDOW=4096
CAMPANARIO_MODEL_MAX_OUTPUT_TOKENS=320
CAMPANARIO_LOW_LATENCY_MODE=true
CAMPANARIO_LIVE_STREAMING=true
CAMPANARIO_CONTEXT_MAX_MESSAGES=12
CAMPANARIO_CONTEXT_AUTO_SUMMARIZE=false
CAMPANARIO_PARTICIPATION_ARBITER_ENABLED=false
CAMPANARIO_MEMORY_ENVIRONMENT=desenvolvimento
# Busca hibrida G2. Instalar: ollama pull embeddinggemma
CAMPANARIO_SEMANTIC_MEMORY_ENABLED=true
CAMPANARIO_SEMANTIC_MEMORY_MODEL=embeddinggemma
CAMPANARIO_SEMANTIC_MEMORY_TIMEOUT_SECONDS=7
CAMPANARIO_SEMANTIC_MEMORY_MIN_SIMILARITY=0.43
CAMPANARIO_SEMANTIC_MEMORY_BATCH_SIZE=32

# Pesquisa web natural no chat; defina false para impedir buscas automaticas.
# Defina true somente quando autorizar pesquisas automáticas e tiver rede.
CAMPANARIO_WEB_AUTO_SEARCH=false
# Com pesquisa web autorizada: online primeiro, depois Wikipedia ZIM e documentos locais.
# Para voltar a prioridade antiga, use local_first. Nao muda a permissao de internet.
CAMPANARIO_RESEARCH_PRIORITY=web_first
# Opcional: um provedor de busca mais estavel que o endpoint publico
# CAMPANARIO_SEARXNG_URL=http://127.0.0.1:8080
# CAMPANARIO_BRAVE_API_KEY=

# Base leve: sem Chroma obrigatorio. Instalacoes existentes preservam o .env.
CAMPANARIO_SEMANTIC_MEMORY_BACKEND=sqlite
# Repositorio de releases opcional, no formato dono/repositorio. Sem consultas automaticas.
CAMPANARIO_UPDATE_REPOSITORY=
CAMPANARIO_DESKTOP_PORT=8000

# Pastas externas (opcionais; ativar somente apos copiar e verificar os dados)
# CAMPANARIO_DATA_DIR=C:\Users\SEU_USUARIO\Documents\GitHub\CAMPANARIO-DATABASE\dados
# CAMPANARIO_ZIM_DIR=C:\Users\SEU_USUARIO\Documents\GitHub\CAMPANARIO-DATABASE\zim

# Wikipedia offline por Kiwix/ZIM (nao acessa a internet).
# Exige wikipedia_pt*.zim em CAMPANARIO-DATABASE\zim e kiwix-tools na pasta irma.
CAMPANARIO_ZIM_ENABLED=false
# When enabled, the Windows desktop starts/stops kiwix-serve automatically.
CAMPANARIO_ZIM_AUTO_START=true
CAMPANARIO_ZIM_BASE_URL=http://127.0.0.1:8181
# CAMPANARIO_ZIM_BOOK_NAME=    # use so se nome Kiwix divergir do nome do ZIM

# V9.1 — expressao factual fundamentada (Ollama local, falha segura)
CAMPANARIO_GROUNDED_EXPRESSION_ENABLED=true
CAMPANARIO_GROUNDED_EXPRESSION_RETRIES=1

# V9 shared brains (opt-in; retains legacy chat when disabled)
CAMPANARIO_BRAINS_V9_ENABLED=false
CAMPANARIO_BRAINS_V9_TIMEOUT_SECONDS=8
CAMPANARIO_BRAINS_V9_MAX_MEMORY_MB=1024

# R2.4 PF6: opcional, senha aleatoria com 32+ caracteres; valor real apenas no .env privado.
# CAMPANARIO_PF6_OWNER_TOKEN=
# R3.3: escrita na Central de Casos por identidade individual (NUNCA conceder acesso por agente):
# CAMPANARIO_CASEWORK_WRITE_ACL_JSON={"alice":["casework"]}

# R3.6 - optional local Case Manager capabilities; all default OFF.
# Requires external CAMPANARIO-PYTHON/.venv and local host packages/models.
CAMPANARIO_CASE_OCR_ENABLED=false
CAMPANARIO_CASE_SEMANTIC_ENABLED=false
CAMPANARIO_CASE_EMBED_MODEL=nomic-embed-text
CAMPANARIO_CASE_VISION_ENABLED=false
CAMPANARIO_CASE_VISION_MODEL=llava

# R3.10: sugestoes SEMANTICAS locais de trechos ja verificados; desativado por padrao.
# Nunca equivale a verificacao de verdade, autoria, culpa ou causalidade.
CAMPANARIO_CASE_CLAIMS_SEMANTIC_ENABLED=false
# Configure apenas com um modelo de chat ja instalado no Ollama local:
CAMPANARIO_CASE_CLAIMS_SEMANTIC_MODEL=

# R3.11: instalacao pessoal, ativacao assistida por diagnostico local (nao copiar
# os valores "true" cegamente). Rode ATIVAR_RECURSOS_LOCAIS_R311.bat com duplo clique.
# O ativador faz backup do .env existente, consulta modelos locais em loopback,
# verifica OCR e habilita so recursos encontrados. Nao habilita web, sandbox,
# escrita autonoma, acesso remoto, V9 experimental ou credenciais.
# CAMPANARIO_LIBRARY_SEMANTIC_ENABLED=false
# CAMPANARIO_LIBRARY_SEMANTIC_MODEL=embeddinggemma

# R3.14 - modo pessoal local (PADRAO): nao exige PF6, credenciais nem
# aprovacoes por operacao, mesmo que credenciais antigas estejam no .env.
# Define false somente se realmente quiser recuperar o modo protegido multiusuario.
CAMPANARIO_LOCAL_PERSONAL_MODE=true

# Maps V2: serviços locais opcionais; não são baixados automaticamente.
# OSRM driving: instale grafo OSM em um processo local separado.
CAMPANARIO_MAPS_ROUTER_URL=http://127.0.0.1:5000
# OSRM walking deve usar grafo separado preparado para pedestres.
CAMPANARIO_MAPS_WALK_ROUTER_URL=http://127.0.0.1:5001
# Nominatim com índice regional OSM; modo pessoal local.
CAMPANARIO_MAPS_GEOCODER_URL=http://127.0.0.1:8088

# Consultas de estabelecimentos proximos por categoria (dados OSM regionais):
CAMPANARIO_MAPS_OVERPASS_URL=http://127.0.0.1:12345

# Opcional: arquivo raster local de tiles (nao e grafo para roteamento)
CAMPANARIO_MBTILES=

# R3.20 - fallback público automático somente ao pesquisar/rotear (não envia GPS em segundo plano).
# Consultas e coordenadas da rota serão enviadas a serviços OSM públicos se local estiver fora do ar.
# Desative para operação estritamente local/offline.
CAMPANARIO_MAPS_PUBLIC_FALLBACK=true
# Opcional: personalize User-Agent com um contato seu para respeitar as políticas dos serviços OSM.
# CAMPANARIO_MAPS_USER_AGENT=CampanarioMaps/3.20 (contato: seu-email@example.com)

# R3.21 / GitHub Pages: origem HTTPS exata do site (sem caminho /repositorio)
# Deixe vazio para bloquear acessos cross-origin de navegadores Pages.
CAMPANARIO_FIELD_PAGES_ORIGIN=
