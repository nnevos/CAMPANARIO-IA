CAMPANARIO_LOG_LEVEL=INFO

# Model runtime. Gemma 3 12B is the current recommended baseline, not an architectural dependency.
CAMPANARIO_MODEL_PROVIDER=ollama
CAMPANARIO_MODEL_NAME=gemma3:12b
CAMPANARIO_MODEL_BASE_URL=http://127.0.0.1:11434
CAMPANARIO_MODEL_TIMEOUT_SECONDS=120
CAMPANARIO_MODEL_TEMPERATURE=0.35

# Legacy aliases kept only for compatibility with older local .env files.
CAMPANARIO_OLLAMA_BASE_URL=http://127.0.0.1:11434
CAMPANARIO_OLLAMA_MODEL=
CAMPANARIO_OLLAMA_TIMEOUT_SECONDS=120
CAMPANARIO_OLLAMA_TEMPERATURE=0.35

CAMPANARIO_CONTEXT_MAX_MESSAGES=20
CAMPANARIO_CONTEXT_SUMMARY_MAX_CHARS=4000

# F5c Host Voice Integration (disabled by default)
# Windows target baseline: local whisper.cpp STT + Windows SAPI TTS.
CAMPANARIO_VOICE_STT_BACKEND=unconfigured
CAMPANARIO_VOICE_TTS_BACKEND=unconfigured
CAMPANARIO_VOICE_WHISPER_CPP_PATH=whisper-cli.exe
# Prefer a shared external model store so large .bin files stay out of project ZIPs.
# CAMPANARIO_VOICE_MODELS_DIR=C:\Users\SEU_USUARIO\AppData\Local\Campanario\models
# CAMPANARIO_VOICE_WHISPER_MODEL_PATH=C:\WhisperModels\ggml-small.bin
CAMPANARIO_VOICE_POWERSHELL_PATH=powershell.exe
# Optional exact SAPI voice names. Leave blank to use system default + different rates.
CAMPANARIO_VOICE_TODD_VOICE=
CAMPANARIO_VOICE_MORGANA_VOICE=
# SAPI rate: -10 (muito lenta) a +10 (muito rapida). F5 usa um default mais agil.
CAMPANARIO_VOICE_TODD_RATE=4
CAMPANARIO_VOICE_MORGANA_RATE=3
CAMPANARIO_VOICE_VAD_THRESHOLD=450
CAMPANARIO_VOICE_SILENCE_FRAMES_TO_FINALIZE=45
CAMPANARIO_VOICE_PREROLL_FRAMES=6

# F5c.1 voice capture/STT stabilization
# Portuguese is explicit; do not use ggml-*.en.bin for pt-BR.
CAMPANARIO_VOICE_LANGUAGE=pt
CAMPANARIO_VOICE_WHISPER_PROMPT=Campanario. Todd. Morgana.
CAMPANARIO_VOICE_WHISPER_NO_SPEECH_THRESHOLD=0.50
CAMPANARIO_VOICE_WHISPER_PREFER_ACCURACY=true
CAMPANARIO_VOICE_MIN_SPEECH_MS=300

# F5c.10 optional physical voice tuning
# CAMPANARIO_VOICE_FRAGMENT_HOLD_MS=1200
# CAMPANARIO_VOICE_BARGE_IN_THRESHOLD=1600
# CAMPANARIO_VOICE_BARGE_IN_FRAMES=2
# CAMPANARIO_VOICE_BARGE_IN_PREROLL_FRAMES=6
